/-
§2.2.1 of

  Zahra Nazemian and Daniel Smertnig,
  *A monoid-theoretical approach to infinite direct-sum decompositions of modules*,

the two characterisations of the section.

* **Which cyclic monoids are `V(𝓕)`.**  For a ring `R`, `V(𝓕)` is the cyclic monoid generated by
  `[R]`, so its presentation is the relation `R^k ≅ R^l` on ranks.  By the classification of cyclic
  monoids that relation is equality (`ℕ₀`) or `∼_{m,n}` (`C_{m,n}`), and the paper observes that
  `C_{0,n}` forces `R^0 ≅ R^n`, hence `R = 0` and `n = 1`.  With Leavitt's theorem for `m ≥ 1`
  this makes the realisable cyclic monoids exactly `ℕ₀`, `C_{m,n}` with `m, n ≥ 1`, and
  `C_{0,1} = {0}` (`cyclicRel_realisable_iff`, `rankRel_classification`).
* **Proposition 2.16, both directions.**  Over a nonzero ring `V^κ(𝓕^κ)` is cyclic, generated by
  the faithful order-unit `[R]` (`prop_2_16_converse`); with `prop_2_16` this says the
  `κ`-monoids realisable as `V^κ(𝓕^κ)` over a nonzero ring are precisely the cyclic `κ`-monoids
  generated by a faithful order-unit (`prop_2_16_iff`).

In the `CyclicRel` encoding `C_{m,0}` is `ℕ₀` for every `m` (`cyclicRel_zero_right`), so the list
of realisable presentations reads `n = 0 ∨ (1 ≤ m ∧ 1 ≤ n) ∨ (m = 0 ∧ n = 1)`.  The realisation of
`C_{m,n}` with `m ≥ 1` is Leavitt's theorem, which here rests on the Bergman–Dicks theorem.
-/
import KappaMonoid.Modules.Rings.Realisation
import KappaMonoid.Core.OrderUnitIso

universe u

open Cardinal DirectSum

namespace KappaMonoid

open KMonoid

/-! ## `C_{0,n}` is realised only by the zero ring -/

section ZeroRing

/-- `∼_{m,0}` is equality: `C_{m,0} = ℕ₀`. -/
theorem cyclicRel_zero_right {m k l : ℕ} : CyclicRel m 0 k l ↔ k = l := by
  constructor
  · rintro (h | ⟨-, -, hd⟩)
    · exact h
    · rw [Nat.cast_zero, zero_dvd_iff] at hd
      omega
  · exact fun h => Or.inl h

/-- `0 ∼_{0,n} n`: in `C_{0,n}` the element `n` is zero. -/
theorem cyclicRel_zero_left_self (n : ℕ) : CyclicRel 0 n 0 n :=
  Or.inr ⟨le_rfl, Nat.zero_le n, ⟨-1, by push_cast; ring⟩⟩

variable {R : Type u} [Ring R]

/-- If `R^0 ≅ R^n` with `n ≥ 1`, then `R = 0`: `R` is a summand of `R^n = 0`. -/
theorem subsingleton_of_iso_fin_zero {n : ℕ} (hn : 1 ≤ n)
    (e : (⨁ _ : Fin 0, R) ≃ₗ[R] (⨁ _ : Fin n, R)) : Subsingleton R := by
  have h0 : ∀ x : ⨁ _ : Fin 0, R, x = 0 := fun x => DFinsupp.ext fun i => i.elim0
  have hr : ∀ r : R, r = 0 := by
    intro r
    have hl : DirectSum.lof R (Fin n) (fun _ => R) ⟨0, hn⟩ r = 0 := by
      rw [← e.apply_symm_apply (DirectSum.lof R (Fin n) (fun _ => R) ⟨0, hn⟩ r),
        h0 (e.symm _), map_zero]
    have := congrArg (DirectSum.component R (Fin n) (fun _ => R) ⟨0, hn⟩) hl
    rwa [DirectSum.component.lof_self, map_zero] at this
  exact ⟨fun a b => by rw [hr a, hr b]⟩

/-- Over the zero ring every two finitely generated free modules are isomorphic. -/
theorem nonempty_iso_fin_of_subsingleton [Subsingleton R] (k l : ℕ) :
    Nonempty ((⨁ _ : Fin k, R) ≃ₗ[R] (⨁ _ : Fin l, R)) := by
  have := Module.subsingleton R (⨁ _ : Fin k, R)
  have := Module.subsingleton R (⨁ _ : Fin l, R)
  exact ⟨LinearEquiv.ofSubsingleton _ _⟩

/-- **§2.2.1**: *"Realizing a monoid of the form `C_{0,n}` implies `0 ≅ R^n` for some `n ≥ 1`, so
only the trivial ring `R = 0` can realize such a monoid, forcing `n = 1`."*

If the rank relation `R^k ≅ R^l` of a ring is `∼_{0,n}` with `n ≥ 1`, then `R` is the zero ring
and `n = 1`. -/
theorem subsingleton_of_realises_cyclicRel_zero {n : ℕ} (hn : 1 ≤ n)
    (h : ∀ k l : ℕ, Nonempty ((⨁ _ : Fin k, R) ≃ₗ[R] (⨁ _ : Fin l, R)) ↔ CyclicRel 0 n k l) :
    Subsingleton R ∧ n = 1 := by
  have hsub : Subsingleton R :=
    subsingleton_of_iso_fin_zero hn ((h 0 n).mpr (cyclicRel_zero_left_self n)).some
  refine ⟨hsub, ?_⟩
  rcases (h 0 1).mp (nonempty_iso_fin_of_subsingleton 0 1) with h01 | ⟨-, -, hd⟩
  · exact absurd h01 zero_ne_one
  · have hd' : (n : ℤ) ∣ 1 := by simpa using hd
    exact Nat.dvd_one.mp (Int.natCast_dvd_natCast.mp hd')

end ZeroRing

/-! ## The realisable cyclic monoids -/

/-- **§2.2.1**: the cyclic monoids realisable as `V(𝓕)` are exactly `ℕ₀`, `C_{m,n}` with
`m, n ≥ 1`, and `C_{0,1} = {0}`.

Stated for the presentation `∼_{m,n}` of `C_{m,n}`; since `C_{m,0} = ℕ₀` in this encoding
(`cyclicRel_zero_right`), the case `n = 0` is the paper's `ℕ₀`.  The three cases are realised by
`ℚ` (invariant basis number), by Leavitt's theorem, and by the zero ring; conversely `C_{0,n}`
needs `R = 0`, which forces `n = 1` (`subsingleton_of_realises_cyclicRel_zero`).

The case `m, n ≥ 1` is Leavitt's theorem, here deduced from the Bergman–Dicks theorem. -/
theorem cyclicRel_realisable_iff (m n : ℕ) :
    (∃ (R : Type u) (_ : Ring R), ∀ k l : ℕ,
        Nonempty ((⨁ _ : Fin k, R) ≃ₗ[R] (⨁ _ : Fin l, R)) ↔ CyclicRel m n k l) ↔
      n = 0 ∨ (1 ≤ m ∧ 1 ≤ n) ∨ (m = 0 ∧ n = 1) := by
  constructor
  · rintro ⟨R, _, h⟩
    rcases Nat.eq_zero_or_pos n with hn | hn
    · exact Or.inl hn
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      exact Or.inr (Or.inr ⟨rfl, (subsingleton_of_realises_cyclicRel_zero hn h).2⟩)
    · exact Or.inr (Or.inl ⟨hm, hn⟩)
  · rintro (rfl | ⟨hm, hn⟩ | ⟨rfl, rfl⟩)
    · exact ⟨realiserEq.{u}.R, inferInstance, fun k l => by
        rw [realiserEq.iso_iff, cyclicRel_zero_right]⟩
    · exact ⟨(realiserCyclicRel.{u} m n hm hn).R, inferInstance,
        (realiserCyclicRel m n hm hn).iso_iff⟩
    · refine ⟨PUnit.{u + 1}, inferInstance, fun k l => ⟨fun _ => ?_, fun _ => ?_⟩⟩
      · exact Or.inr ⟨Nat.zero_le k, Nat.zero_le l, by push_cast; exact one_dvd _⟩
      · exact nonempty_iso_fin_of_subsingleton k l

/-- **§2.2.1**, for a given ring: the rank relation `R^k ≅ R^l` of every ring is the presentation
of `ℕ₀`, of `C_{m,n}` with `m, n ≥ 1`, or of `C_{0,1}`.

`V(𝓕)` is the cyclic monoid generated by `[R]` — here the finite multiples of `[R]` in
`V^{ℵ₀}(𝓕^{ℵ₀})` — so the classification of cyclic monoids applies to it, and
`subsingleton_of_realises_cyclicRel_zero` excludes `C_{0,n}` for `n ≥ 2`.  No axiom is involved:
this is the "only these" half; that each case occurs is `cyclicRel_realisable_iff`. -/
theorem rankRel_classification (R : Type u) [Ring R] :
    (∀ k l : ℕ, Nonempty ((⨁ _ : Fin k, R) ≃ₗ[R] (⨁ _ : Fin l, R)) ↔ k = l) ∨
      ∃ m n : ℕ, ((1 ≤ m ∧ 1 ≤ n) ∨ (m = 0 ∧ n = 1)) ∧
        ∀ k l : ℕ, Nonempty ((⨁ _ : Fin k, R) ≃ₗ[R] (⨁ _ : Fin l, R)) ↔ CyclicRel m n k l := by
  classical
  let := (FreeMod.freeClass R (ℵ₀ : Cardinal.{u}) le_rfl).instKMonoid le_rfl
  obtain ⟨k₀⟩ := nonempty_Idx (le_refl (ℵ₀ : Cardinal.{u}))
  set u := FreeMod.unit R (ℵ₀ : Cardinal.{u}) le_rfl k₀ with hu
  -- `k • [R]` is the class of `R^k`
  have hmk : ∀ k : ℕ, k • u = FreeMod.mkC R ℵ₀ le_rfl (FreeMod.setOfCard (natCast_le le_rfl k)) :=
    fun k => by
      rw [← KMonoid.cmul_natCast u k]
      exact FreeMod.cmul_unit le_rfl k₀ _ (FreeMod.mk_setOfCard _)
  have hrank : ∀ k l : ℕ,
      k • u = l • u ↔ Nonempty ((⨁ _ : Fin k, R) ≃ₗ[R] (⨁ _ : Fin l, R)) := by
    intro k l
    have ek := (ofSet_equiv_fin (R := R)
      (FreeMod.mk_setOfCard (natCast_le (le_refl (ℵ₀ : Cardinal.{u})) k))).some
    have el := (ofSet_equiv_fin (R := R)
      (FreeMod.mk_setOfCard (natCast_le (le_refl (ℵ₀ : Cardinal.{u})) l))).some
    rw [hmk, hmk, FreeMod.mkC_eq_mkC_iff]
    exact ⟨fun ⟨e⟩ => ⟨(ek.symm.trans e).trans el⟩, fun ⟨e⟩ => ⟨(ek.trans e).trans el.symm⟩⟩
  rcases cyclicMonoidClassification u with hinj | ⟨m, n, hn, hrel⟩
  · exact Or.inl fun k l => (hrank k l).symm.trans (hinj k l)
  · have h : ∀ k l : ℕ,
        Nonempty ((⨁ _ : Fin k, R) ≃ₗ[R] (⨁ _ : Fin l, R)) ↔ CyclicRel m n k l :=
      fun k l => (hrank k l).symm.trans (hrel k l)
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      exact Or.inr ⟨0, n, Or.inr ⟨rfl, (subsingleton_of_realises_cyclicRel_zero hn h).2⟩, h⟩
    · exact Or.inr ⟨m, n, Or.inl ⟨hm, hn⟩, h⟩

/-! ## Proposition 2.16, the converse -/

namespace FreeMod

variable {R : Type u} [Ring R] {κ : Cardinal.{u}}

/-- **§2.2.1, before Proposition 2.16**: `V^κ(𝓕^κ)` is generated as a `κ`-monoid by `[R]` —
every class is `α [R]` (`exists_cmul_unit`), a sum of `α` copies of `[R]`. -/
theorem kGenerates_unit (hκ : ℵ₀ ≤ κ) (k : Idx κ) :
    letI := (freeClass R κ hκ).instKMonoid hκ
    KGenerates κ ({unit R κ hκ k} : Set (freeClass R κ hκ).carrier) := by
  let := (freeClass R κ hκ).instKMonoid hκ
  refine kGenerates_iff.mpr fun a => ?_
  obtain ⟨α, hα, rfl⟩ := exists_cmul_unit hκ k a
  rw [← KMonoid.cmul_congr (mk_Idx α) (le_of_eq_of_le (mk_Idx α) hα) hα, ← sumOf_const]
  exact (isKSubmonoid_kclosure κ _).sumOf_mem (h := CardLE.mk' (le_of_eq_of_le (mk_Idx α) hα)) _
    fun _ => subset_kclosure rfl

/-- `V^κ(𝓕^κ)` is a cyclic `κ`-monoid (Definition 2.10(2)). -/
theorem isCyclicKMonoid (hκ : ℵ₀ ≤ κ) :
    letI := (freeClass R κ hκ).instKMonoid hκ
    IsCyclicKMonoid κ (freeClass R κ hκ).carrier := by
  let := (freeClass R κ hκ).instKMonoid hκ
  obtain ⟨k⟩ := nonempty_Idx hκ
  exact isCyclicKMonoid_iff.mpr ⟨_, kGenerates_unit hκ k⟩

end FreeMod

/-- **Proposition 2.16, converse** (the sentence after its proof): over a nonzero ring,
`V^κ(𝓕^κ)` is a cyclic `κ`-monoid generated by a faithful order-unit, namely `[R]`.

Faithfulness is invariance of infinite rank (`FreeMod.isFaithful_unit`); generation is
`FreeMod.kGenerates_unit`. -/
theorem prop_2_16_converse {R : Type u} [Ring R] [Nontrivial R] {κ : Cardinal.{u}}
    (hκ : ℵ₀ ≤ κ) :
    letI := (FreeMod.freeClass R κ hκ).instKMonoid hκ
    IsCyclicKMonoid κ (FreeMod.freeClass R κ hκ).carrier ∧
      ∃ u : (FreeMod.freeClass R κ hκ).carrier,
        IsFaithful (κ := κ) u ∧ KGenerates κ ({u} : Set (FreeMod.freeClass R κ hκ).carrier) := by
  let := (FreeMod.freeClass R κ hκ).instKMonoid hκ
  obtain ⟨k⟩ := nonempty_Idx hκ
  exact ⟨FreeMod.isCyclicKMonoid hκ, FreeMod.unit R κ hκ k, FreeMod.isFaithful_unit hκ k,
    FreeMod.kGenerates_unit hκ k⟩

/-- **Proposition 2.16 and its converse**: *"the `κ`-monoids having realization as `κ`-monoids of
free modules over a nonzero ring are precisely the cyclic `κ`-monoids generated by a faithful
order-unit."*

Forward: `[R]` is a faithful generator of `V^κ(𝓕^κ)` (`prop_2_16_converse`), and both properties
transport along a `κ`-isomorphism.  Backward: `prop_2_16`, whose realising ring is nonzero.  The
backward direction uses Leavitt's theorem, hence the Bergman–Dicks theorem, when the size-zero
submonoid is finite. -/
theorem prop_2_16_iff {κ : Cardinal.{u}} (hκ : ℵ₀ ≤ κ) (H : Type u) [KMonoid κ H] :
    (∃ (R : Type u) (_ : Ring R) (_ : Nontrivial R)
        (φ : (FreeMod.freeClass R κ hκ).carrier → H),
        letI := (FreeMod.freeClass R κ hκ).instKMonoid hκ
        IsKHom κ φ ∧ Function.Bijective φ) ↔
      ∃ u : H, IsFaithful (κ := κ) u ∧ KGenerates κ ({u} : Set H) := by
  constructor
  · rintro ⟨R, _, _, φ, hφ, hbij⟩
    let := (FreeMod.freeClass R κ hκ).instKMonoid hκ
    obtain ⟨-, u, hu, hgen⟩ := prop_2_16_converse (R := R) hκ
    refine ⟨φ u, hu.map hφ hbij, ?_⟩
    have := KGenerates.map hφ hbij.2 hgen
    rwa [Set.image_singleton] at this
  · rintro ⟨u, hu, hgen⟩
    obtain ⟨P, Rl, φ, hφ, hbij⟩ := prop_2_16 hκ H u hu hgen
    exact ⟨Rl.R, inferInstance, inferInstance, φ, hφ, hbij⟩

end KappaMonoid
