/-
**Order-units and faithful order-units transport along `κ`-isomorphisms.**

Definition 2.12 is phrased in terms of `+`, `cmul` and the algebraic preorder `≼`, all of which a
bijective `κ`-homomorphism preserves and reflects.  Used to carry "cyclic, generated by a faithful
order-unit" from `V^κ(𝓕^κ)` to any `κ`-monoid isomorphic to it (Proposition 2.16 and its converse).
-/
import KappaMonoid.Core.OrderUnit

universe u v w

open Cardinal

namespace KappaMonoid

namespace KMonoid

variable {κ : Cardinal.{u}} {H : Type v} [KMonoid κ H] {K : Type w} [KMonoid κ K]

/-- A `κ`-homomorphism preserves `≼`. -/
theorem IsKHom.addLe {e : H → K} (he : IsKHom κ e) {a b : H} (h : a ≼ b) : e a ≼ e b := by
  obtain ⟨c, rfl⟩ := h
  exact ⟨e c, (he.map_add a c).symm⟩

/-- An injective `κ`-homomorphism reflects `≼` when it is also surjective. -/
theorem IsKHom.addLe_of_bijective {e : H → K} (he : IsKHom κ e) (hbij : Function.Bijective e)
    {a b : H} (h : e a ≼ e b) : a ≼ b := by
  obtain ⟨c', hc'⟩ := h
  obtain ⟨c, rfl⟩ := hbij.2 c'
  exact ⟨c, hbij.1 (by rw [he.map_add, hc'])⟩

/-- **Definition 2.12(1)**, transported: a surjective `κ`-homomorphism carries order-units to
order-units. -/
theorem IsOrderUnit.map {e : H → K} (he : IsKHom κ e) (hsurj : Function.Surjective e) {u : H}
    (hu : IsOrderUnit (κ := κ) u) : IsOrderUnit (κ := κ) (e u) := by
  intro y
  obtain ⟨x, rfl⟩ := hsurj y
  rw [← he.map_cmul]
  exact he.addLe (hu x)

/-- **Definition 2.12(2)**, transported: a `κ`-isomorphism carries faithful order-units to faithful
order-units. -/
theorem IsFaithful.map {e : H → K} (he : IsKHom κ e) (hbij : Function.Bijective e) {u : H}
    (hu : IsFaithful (κ := κ) u) : IsFaithful (κ := κ) (e u) := by
  refine ⟨hu.1.map he hbij.2, fun α β hα hβ hαβ hβ0 h => ?_⟩
  rw [← he.map_cmul, ← he.map_cmul] at h
  exact hu.2 α β hα hβ hαβ hβ0 (he.addLe_of_bijective hbij h)

end KMonoid

end KappaMonoid
